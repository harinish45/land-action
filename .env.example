# LandAction Environment Configuration

# Server Port
PORT=3000

# Node Environment
NODE_ENV=production

# Base URL (for production deployments)
BASE_URL=https://land-action.vercel.app

# Optional: Mapbox / Leaflet Tiles API Key (defaults to open-source OSM tiles)
MAP_TILES_API_KEY=

# Optional: Redis Cache URL for high-scale document caching
REDIS_URL=
