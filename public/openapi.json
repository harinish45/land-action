{
  "openapi": "3.1.0",
  "info": {
    "title": "LandAction API",
    "description": "Autonomous Cadastral Intelligence, Land Due Diligence, Guideline Valuation, and TNCDBR 2019 Building Scope API for India.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://land-action.vercel.app",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/v1/verify": {
      "post": {
        "summary": "Verify Land Parcel (33 Automated Checks)",
        "operationId": "verifyLandParcel",
        "description": "Runs 33 statutory due diligence checks on a land parcel in Tamil Nadu across revenue records, encumbrance history, water body buffers, coastal CRZ, and zoning.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "survey_no": {
                    "type": "string",
                    "description": "Survey number (e.g. '112/5', '163/2', '42/2')",
                    "example": "112/5"
                  },
                  "taluk": {
                    "type": "string",
                    "description": "Taluk name",
                    "example": "Sholinganallur"
                  },
                  "district": {
                    "type": "string",
                    "description": "District name",
                    "example": "Chennai"
                  }
                },
                "required": ["survey_no"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Due diligence verification report with 33 checks and safety index."
          }
        }
      }
    },
    "/api/v1/tools/{toolId}": {
      "post": {
        "summary": "Run Specialized Real Estate Mini Tool",
        "operationId": "runMiniTool",
        "description": "Executes specialized real estate calculators (stamp duty, guideline value, zoning check, Patta verification, build scope). Always free: cost 0 credits.",
        "parameters": [
          {
            "name": "toolId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Any of the 33 core tool slugs (see GET /api/v1/tools) e.g. guideline_value, stamp_duty, zone_check, fetch_land_record, ec_transactions, build_scope, unit_convert"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "survey_no": { "type": "string", "example": "112/5" },
                  "property_value": { "type": "number", "example": 10000000 },
                  "plot_area_sqft": { "type": "number", "example": 4800 },
                  "road_width_m": { "type": "number", "example": 12 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool calculation result."
          }
        }
      }
    },
    "/api/v1/tools": {
      "get": {
        "summary": "List All Core Tools (33)",
        "operationId": "listTools",
        "description": "Lists the 33 core LandAction tools with slugs, pricing (all free) and categories.",
        "responses": {
          "200": {
            "description": "Tool catalog with total_tools and tools array."
          }
        }
      }
    },
    "/api/v1/minis": {
      "get": {
        "summary": "List All 123 Free Minis",
        "operationId": "listMinis",
        "description": "Lists the 123 free LandAction Mini calculators across 10 categories. All cost 0 credits.",
        "responses": {
          "200": {
            "description": "Minis catalog with total, categories and tools array."
          }
        }
      }
    },
    "/api/v1/minis/{slug}/run": {
      "post": {
        "summary": "Run a Free Mini Calculator",
        "operationId": "runMini",
        "description": "Runs one of the 123 minis. Always free: response reports charged:false. Body accepts survey_no/query/value/property_value.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Mini slug e.g. guideline-value, stamp-duty-tn, fsi-calculator"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mini result with verdict, rows, charged:false."
          }
        }
      }
    },
    "/api/v1/geo/districts": {
      "get": {
        "summary": "List Tamil Nadu Districts",
        "operationId": "listDistricts",
        "description": "Lists all 38 Tamil Nadu districts in the cadastral register.",
        "responses": {
          "200": {
            "description": "District list with total and districts array."
          }
        }
      }
    },
    "/api/v1/documents/{docType}": {
      "post": {
        "summary": "Generate a Land Document Extract",
        "operationId": "generateDocument",
        "description": "Generates a document extract (patta-chitta, ec, guideline, zoning, fmb, a-register, or bundle) for a survey number. Free.",
        "parameters": [
          {
            "name": "docType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["patta-chitta", "ec", "guideline", "zoning", "fmb", "a-register", "bundle"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document extract payload."
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "summary": "Veritas AI Real Estate Legal Inquiry",
        "operationId": "askVeritasAI",
        "description": "Queries Veritas AI real estate copilot with statutory Tamil Nadu law references.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": { "type": "string", "example": "Can I construct Stilt + 5 floors on a 12m road in Karapakkam?" }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Legal response with citations."
          }
        }
      }
    },
    "/api/v1/states": {
      "get": {
        "summary": "List Pan-India Land Record Portals",
        "operationId": "listStatePortals",
        "description": "Lists official government revenue and registration portals for 28 Indian states.",
        "responses": {
          "200": {
            "description": "List of state portals."
          }
        }
      }
    }
  }
}
